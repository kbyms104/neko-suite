# ==========================================
# Neko Suite Root .gitignore
# ==========================================

# Node & Package Managers
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build Output Directories
dist/
**/dist/
build/
**/build/
out/
**/out/

# Rust / Cargo
target/
**/target/
**/src-tauri/target/
**/*.rs.bk
Cargo.lock.bak

# Tauri
.tauri/
**/.tauri/
**/src-tauri/WixTools/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE & Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
logs/
*.log

# Large Generated Test Data (reproducible via scripts/generate_test_data.js)
test_data/_*
test_data/__*
test_data/*100k*
test_data/*50k*
test_data/*10k*

